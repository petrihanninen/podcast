# Postgres (Neon pooled connection string in production)
DATABASE_URL=postgresql://podcast:podcast@localhost:9002/podcast

# LLM provider API keys
GOOGLE_API_KEY=          # Gemini: research with Google Search grounding (default)
OPENAI_API_KEY=          # GPT-5.6 Luna: transcript + titles (default)
ANTHROPIC_API_KEY=       # optional, only for TRANSCRIPT_MODEL=claude-haiku

# Text-to-speech: Chatterbox Turbo hosted on DeepInfra (https://deepinfra.com)
DEEPINFRA_API_KEY=

# S3-compatible object storage for the MP3s (Cloudflare R2, Backblaze B2, Neon Object Storage, ...)
STORAGE_ENDPOINT=        # e.g. https://<account>.r2.cloudflarestorage.com or https://s3.eu-central-003.backblazeb2.com
STORAGE_REGION=auto
STORAGE_BUCKET=podcast
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_URL=      # public base URL of the bucket, e.g. https://audio.example.com or https://f003.backblazeb2.com/file/podcast
STORAGE_FORCE_PATH_STYLE=true

# Public URL of the app (RSS links, login callback); defaults to the Vercel production URL
BASE_URL=http://localhost:3000

# Auth
SESSION_SECRET=          # openssl rand -hex 32
REGISTER_TOKEN=          # share /register?token=<this> to invite users

# Optional tuning
# RESEARCH_MODEL=gemini-flash         # gemini-flash | gemini-flash-lite | gpt-luna | gpt-6-luna
# TRANSCRIPT_MODEL=gpt-luna           # gpt-luna | gpt-6-luna | gemini-flash | gemini-flash-lite | claude-haiku
# TTS_MODEL=chatterbox-turbo
# TTS_CONCURRENCY=4                   # parallel TTS requests inside one batch step
# TTS_BATCH_SIZE=12                   # dialogue lines per batch step (keep each step well under 300 s)
# TTS_PARALLEL_BATCHES=4              # batch steps running at the same time
# MP3_KBPS=64
# DAILY_SPEND_LIMIT=5.0               # pause new pipeline steps once today's estimated spend (USD) passes this
