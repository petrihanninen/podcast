# LLM provider API keys
# Research (web-grounded notes) defaults to Gemini 3.8 Flash with Google Search grounding.
GOOGLE_API_KEY=
# Transcript writing defaults to GPT-5.6 Luna.
OPENAI_API_KEY=sk-...
# Optional: only needed if TRANSCRIPT_MODEL=claude-haiku
ANTHROPIC_API_KEY=

# Text-to-speech: Chatterbox Turbo hosted on DeepInfra (https://deepinfra.com)
DEEPINFRA_API_KEY=

# Optional model overrides (keys from src/services/llm-providers.ts and src/services/tts.ts)
# RESEARCH_MODEL=gemini-flash        # gemini-flash | gemini-flash-lite | gpt-luna | gpt-6-luna
# TRANSCRIPT_MODEL=gpt-luna          # gpt-luna | gpt-6-luna | gemini-flash | gemini-flash-lite | claude-haiku
# TTS_MODEL=chatterbox-turbo
# TTS_CONCURRENCY=4

# Stop running costly steps once today's estimated spend (LLM + TTS) exceeds this (USD)
DAILY_SPEND_LIMIT=5.0

# PostgreSQL connection string
DATABASE_URL=postgresql://podcast:podcast@localhost:9002/podcast

# Where episode audio files are stored
AUDIO_DIR=/data/audio

# Directory for voice reference .wav samples (uploaded once to DeepInfra as cloned voices)
VOICE_REFS_DIR=/app/voice_refs

# Public URL (used in RSS feed links)
BASE_URL=http://localhost:9001

# Auth
SESSION_SECRET=
# Secret token for invite-only registration (share /register?token=<this> to invite users)
REGISTER_TOKEN=
