{
  "name": "podcast",
  "version": "0.1.0",
  "description": "Private podcast feed generator",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-assets.mjs && nitro dev",
    "build": "node scripts/build-assets.mjs && nitro build",
    "typecheck": "node scripts/build-assets.mjs && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@fastify/cookie": "^11.0.0",
    "@fastify/formbody": "^8.0.0",
    "@vercel/functions": "^3.10.3",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.39.0",
    "fastify": "^5.2.0",
    "jose": "^6.0.0",
    "nitro": "^3.0.260903-beta",
    "nunjucks": "^3.2.4",
    "pg": "^8.13.0",
    "rollup": "^4.65.0",
    "wasm-media-encoders": "^0.7.0",
    "workflow": "^5.2.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nunjucks": "^3.2.6",
    "@types/pg": "^8.11.0",
    "drizzle-kit": "^0.30.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.20.0"
}
